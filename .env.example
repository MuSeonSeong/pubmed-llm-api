DEVICE=auto
MODELS_DIR=models
MAX_CONTEXT_TOKENS=8192
PUBMED_MCP_URL=https://pubmed.caseyjhand.com/mcp
# 계정·대화·첨부 이미지를 저장할 폴더 (Git에는 올라가지 않습니다)
DATA_DIR=data
# true면 로그인해야 쓸 수 있는 계정 모드, false면 로그인 없는 로컬 모드. scripts/serve.py는 항상 true로 실행합니다
AUTH_ENABLED=false
# 로그인 유지 기간(일, 1~365)
SESSION_DAYS=30
# 계정마다 저장할 수 있는 대화와 첨부 파일 용량의 합(MB)
USER_STORAGE_MB=500
