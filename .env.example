# 쓸 모델 ID를 쉼표로 구분, 첫 번째가 기본 모델 (예: qwen3.5-9b,qwen3.5-4b). 비우면 Apple Silicon 맥에서는 MLX 모델 전부, 그 밖에서는 Transformers 모델 전부
MODELS=
# 서버가 켜질 때 미리 불러와 계속 메모리에 둘 MLX 모델: default(기본 모델만), all(모두), none(없음). 나머지는 첫 질문 때 불러옵니다
PRELOAD_MODELS=default
# 미리 불러오지 않은 MLX 모델은 이 시간(분) 동안 질문이 없으면 꺼서 메모리를 돌려줍니다. 0이면 끄지 않음
MLX_IDLE_MINUTES=10
# MLX 접두 캐시를 디스크(DATA_DIR/kv-cache)에도 둘 용량(GB, 모든 모델 합계). 0이면 메모리에만 둡니다
KV_CACHE_GB=0
# Qwen3.5가 캐시된 앞부분에서 이어 읽을 체크포인트의 간격(토큰)과 프롬프트마다 남길 개수
MLX_CHECKPOINT_INTERVAL=512
MLX_CHECKPOINT_ENTRIES=8
DEVICE=auto
MODELS_DIR=models
MAX_CONTEXT_TOKENS=8192
PUBMED_MCP_URL=https://pubmed.caseyjhand.com/mcp
# 계정·대화·첨부 이미지를 저장할 폴더 (Git에는 올라가지 않습니다)
DATA_DIR=data
# true면 로그인해야 쓸 수 있는 계정 모드, false면 로그인 없는 로컬 모드. scripts/serve.py는 항상 true로 실행합니다
AUTH_ENABLED=false
# 로그인 유지 기간(일, 1~365)
SESSION_DAYS=30
# 계정마다 저장할 수 있는 대화와 첨부 파일 용량의 합(MB)
USER_STORAGE_MB=500
